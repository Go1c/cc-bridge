# ============================================
# Claude Code Gateway 配置文件
# ============================================

# --- 服务器 ---
SERVER_HOST=0.0.0.0
SERVER_PORT=5674

# --- TLS（可选，留空则使用 HTTP） ---
# TLS_CERT_FILE=/path/to/cert.pem
# TLS_KEY_FILE=/path/to/key.pem

# --- 数据库 ---
# 驱动: sqlite（默认）或 postgres
DATABASE_DRIVER=sqlite
# SQLite: 文件路径；Postgres: 连接字符串
DATABASE_DSN=data/claude-code-gateway.db

# Postgres 示例:
# DATABASE_DRIVER=postgres
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_USER=postgres
# DATABASE_PASSWORD=your_password
# DATABASE_DBNAME=ccgateway

# --- Redis（可选，留空则使用内存缓存） ---
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# --- 管理员 ---
ADMIN_PASSWORD=admin

# --- 日志 ---
# 级别: debug, info, warn, error
LOG_LEVEL=info

# --- 用量轮询 ---
# 账户 usage 数据自动刷新间隔（秒），默认 300（5 分钟）
USAGE_POLL_INTERVAL_SECS=300

# --- 上游传输超时（TTFB / connect）---
# TTFB：从 send() 到收到响应头的最长等待（秒）。合法慢 Opus/长上下文仍可能接近该值。
# UPSTREAM_TTFB_TIMEOUT_SECS=120
# TCP/代理/TLS 握手超时（秒）。卡死连接应快失败，不占满 TTFB 预算。
# UPSTREAM_CONNECT_TIMEOUT_SECS=15
# 同账号安全重试：仅在尚未向客户端写任何响应字节时生效；TTFB 不会隔离账号。
# UPSTREAM_TTFB_RETRY_ENABLED=true
# UPSTREAM_TTFB_RETRY_MAX=1
